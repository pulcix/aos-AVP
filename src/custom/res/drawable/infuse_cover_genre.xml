<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#FA4800"
                android:endColor="#FF8704"
                android:type="linear" />
        </shape>
    </item>
    <item
        android:width="64dp"
        android:height="64dp"
        android:gravity="center">
        <vector
            android:width="64dp"
            android:height="64dp"
            android:viewportWidth="24"
            android:viewportHeight="24">
            <!-- Asta superiore mobile (angolata) -->
            <path
                android:strokeColor="#FFFFFF"
                android:strokeWidth="1.5"
                android:strokeLineJoin="round"
                android:strokeLineCap="round"
                android:pathData="M20.2,6 L3,11 l-0.9,-2.4 c-0.3,-1.1 0.3,-2.2 1.3,-2.5 l13.5,-4 c1.1,-0.3 2.2,0.3 2.5,1.3 Z" />
            <!-- Strisce diagonali / (3 equidistanti, passo 4.2) -->
            <path
                android:strokeColor="#FFFFFF"
                android:strokeWidth="1.5"
                android:strokeLineCap="round"
                android:pathData="M5.7,10.2 L7.9,4.8" />
            <path
                android:strokeColor="#FFFFFF"
                android:strokeWidth="1.5"
                android:strokeLineCap="round"
                android:pathData="M9.9,9 L12.1,3.5" />
            <path
                android:strokeColor="#FFFFFF"
                android:strokeWidth="1.5"
                android:strokeLineCap="round"
                android:pathData="M14.1,7.8 L16.3,2.3" />
            <!-- Corpo della lavagna -->
            <path
                android:strokeColor="#FFFFFF"
                android:strokeWidth="1.5"
                android:strokeLineJoin="round"
                android:strokeLineCap="round"
                android:pathData="M3,11 h18 v8 a2,2 0 0 1 -2,2 H5 a2,2 0 0 1 -2,-2 Z" />
            <!-- Simbolo Play al centro con spigoli arrotondati -->
            <path
                android:fillColor="#FFFFFF"
                android:strokeColor="#FFFFFF"
                android:strokeWidth="0.5"
                android:strokeLineJoin="round"
                android:strokeLineCap="round"
                android:pathData="M10.3,14.3 c0,-0.5 0.5,-0.8 0.9,-0.6 l3.2,1.8 c0.4,0.2 0.4,0.8 0,1.0 l-3.2,1.8 c-0.4,0.2 -0.9,-0.1 -0.9,-0.6 Z" />
